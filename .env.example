# ───────── Database (Neon Postgres, Vercel Marketplace 무료 플랜) ─────────
DATABASE_URL=postgres://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ───────── Gemini (Google AI Studio) ─────────
GEMINI_API_KEY=your_gemini_api_key_here
# 모델 ID는 AI Studio에서 정확한 값을 확인해서 넣어주세요
SCREENER_MODEL=gemini-3.8-flash
ANALYZER_MODEL=gemini-3.8-pro

# ───────── Notion (internal integration을 최상위 포트폴리오 페이지에 연결) ─────────
NOTION_TOKEN=ntn_xxx
NOTION_ROOT_PAGE_ID=4feafbfccc56833381b781210ba57e13

# ───────── Dashboard 로그인 (Vercel 전용) ─────────
# `npm run hash-password -- '내비밀번호'` 출력값을 그대로 붙여넣기 (bcrypt 해시를 base64로 인코딩한 값)
AUTH_PASSWORD_HASH_B64=
# 32자 이상 랜덤 문자열 (openssl rand -base64 32)
AUTH_SECRET=

# ───────── GitHub Actions 트리거 (Vercel 전용) ─────────
# Fine-grained PAT: 이 레포만, Actions: Read and write 권한
GH_DISPATCH_TOKEN=
GH_REPO=owner/job-matcher-agent
GH_WORKFLOW=pipeline.yml
GH_REF=main

# ───────── Pipeline 옵션 (로컬/Actions) ─────────
COLLECT_SITES=wanted,saramin,jobkorea
MAX_JOBS_PER_SITE=20
HEADLESS=true
SCREEN_TOP_K=8
FINAL_TOP_K=5
RAW_JOB_WINDOW_DAYS=7
